__pycache__/
*.pyc
*.egg-info/
.venv/
# CI-mirroring venv built by ./ci_env (python + the pinned requirements.txt).
.venv-ci/
.wrangler/
.DS_Store
.claude/
output/
# Derived artifacts are regenerated each run; the raw fetch caches under
# data/raw/ ARE tracked as the dated, change-detected fetch history (trend data).
/data/processed/
# CI deploy-staging dir (the workflow's "Stage deploy directory" step).
# NOTE: .gitignore has no inline comments — a trailing "# ..." on this line would
# become part of the pattern and silently stop ignoring dist/.
/dist/
# npm installs the JS dev tools (eslint, and the pinned wrangler the deploy uses)
# here. package.json and package-lock.json ARE tracked; see the "JS tooling" note
# in CLAUDE.md.
node_modules/
